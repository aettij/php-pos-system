# Database Configuration
# Required PHP extensions: php-pgsql (pdo_pgsql)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=superma_pos
DB_USER=superma_user
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public

# Application Configuration
APP_NAME=SuperMa POS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Security
JWT_SECRET=change_this_to_a_random_64_char_string
SESSION_LIFETIME=7200
CORS_ORIGIN=*
